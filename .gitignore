# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/

# Distribution / packaging
build/
dist/
*.egg-info/

# Testing
.pytest_cache/
coverage.xml
.coverage

# Environments
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Datos (crudos y procesados): no se versionan, se regeneran
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/raw/metadata.json
!data/processed/.gitkeep

# Jupyter
.ipynb_checkpoints/

# MLflow (artefactos y base de datos: se regeneran con 'make train')
mlruns/
mlartifacts/
mlflow.db

# Analisis desechables (no se versionan)
scratch/

# Reportes de drift: la evidencia real (drift.json y drift.html) SI se
# versiona -- es la prueba de monitoreo que pide la rubrica. Lo demas que
# 'make drift' regenere en esta carpeta, no.
reports/*
!reports/drift.json
!reports/drift.html
